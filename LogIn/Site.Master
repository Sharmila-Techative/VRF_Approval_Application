<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="LogIn.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %>Vendor Approval</title>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
    <webopt:BundleReference runat="server" Path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link href="CSS/StyleSheet.css" rel="stylesheet" type="text/css" />
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet' />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>

<body>
    <form runat="server">
        <asp:ScriptManager ID="ScriptManager" runat="server">

            <Scripts>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>

        <div class="sidebar" id="sidebar" runat="server">
            <div class="top">
                <a href="LoginPage.aspx">
                    <div class="logo">
                        <a class="navbar-brand" href="#" style="background-color: whitesmoke; width: 208px">
                            <img style="width: 199px; height: 35px; background-color: whitesmoke" src="../Images/Techative.png" /></a>
                    </div>
                </a>
                <span><i class='bx bx-menu' title="click me" id="btn"></i></span>
            </div>

            <ul>
                <li>
                    <asp:HyperLink runat="server" ID="lnkDashboard" CssClass="nav-item" NavigateUrl="~/Pages/Dashboard.aspx">
                    <i class='bx bxs-widget' title="Dashboard"></i>
                    <span class="nav-item">Dashboard</span>
                    </asp:HyperLink>
                </li>
                <li runat="server" id="liUser">
                    <asp:HyperLink runat="server" ID="lnkUser" CssClass="nav-item" NavigateUrl="~/Pages/UserList.aspx">
                    <i class='bx bxs-user-account' title="User"></i>
                    <span class="nav-item">Add User</span>
                    </asp:HyperLink>
                </li>
                <li runat="server" id="liUser1">
                    <asp:HyperLink runat="server" ID="lnkDepartment" CssClass="nav-item" NavigateUrl="~/Pages/Department.aspx">
        <i class='bx bxs-buildings' title="Department"></i> <!-- Boxicon for department/buildings -->
        <span class="nav-item">Department</span>
                    </asp:HyperLink>
                </li>
                <li runat="server" id="liApprover">
                    <asp:HyperLink runat="server" ID="lnkApprover" CssClass="nav-item" NavigateUrl="~/Pages/Approver.aspx">
        <i class='bx bxs-user-check' title="Approver"></i>
        <span class="nav-item">Approver</span>
                    </asp:HyperLink>
                </li>
                <li>
                    <asp:HyperLink runat="server" ID="VendorForm" CssClass="nav-item" NavigateUrl="~/Pages/VendorForm.aspx">
                    <i class='bx bx-list-ul' title="RegistrationForm"></i>
                    <span class="nav-item">RegistrationForm</span>
                    </asp:HyperLink>
                </li>
                <li>
                    <asp:HyperLink runat="server" ID="HyperLink3" CssClass="nav-item" NavigateUrl="~/Pages/EditableVendorDetails.aspx">
     <i class='bx bx-file-find' title="RejextionForm"></i>
     <span class="nav-item">RejectionForm</span>
                    </asp:HyperLink>
                </li>
                <li runat="server" id="liReport">
                    <asp:HyperLink runat="server" ID="lnkReport" CssClass="nav-item" NavigateUrl="~/Pages/Report.aspx">
        <i class='bx bxs-report' title="Report"></i>
        <span class="nav-item">Report</span>
                    </asp:HyperLink>
                </li>
                <li>
                    <asp:HyperLink runat="server" ID="HyperLink1" CssClass="nav-item" NavigateUrl="~/Pages/LoginPage.aspx">
                    <i class='bx bxs-log-out' title="Logout"></i>
                    <span class="nav-item">Logout</span>
                    </asp:HyperLink>
                </li>
            </ul>
        </div>
        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </div>
    </form>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const btn = document.querySelector('#btn');
            const sidebar = document.querySelector('#sidebar');
            const mainContent = document.querySelector('.container.body-content');
            if (localStorage.getItem('sidebarState') === 'active') {
                sidebar.classList.add('active');
                mainContent.classList.add('active');
            }
            btn.onclick = function () {
                sidebar.classList.toggle('active');
                mainContent.classList.toggle('active');
                if (sidebar.classList.contains('active')) {
                    localStorage.setItem('sidebarState', 'active');
                } else {
                    localStorage.removeItem('sidebarState');
                }
            };
            function disablebackbutton() {
                window.history.forward();
            }
            disablebackbutton();
            window.onload = disablebackbutton;
            window.onpageshow = function (evt) { if (evt.persisted) disablebackbutton(); };
            window.onunload = function () { void (0); };
        });

        const sessionTimeoutMinutes = 20;
        const warningBeforeMinutes = 2;

        const sessionTimeout = sessionTimeoutMinutes * 60 * 1000;
        const warningTime = (sessionTimeoutMinutes - warningBeforeMinutes) * 60 * 1000;

        let timeoutWarningTimer;
        let sessionExpireTimer;
        document.addEventListener("DOMContentLoaded", function () {
            startSessionTimers();
        });
        document.addEventListener("mousemove", resetTimers);
        document.addEventListener("keydown", resetTimers);
        document.addEventListener("click", resetTimers);

        function startSessionTimers() {
            clearTimeout(timeoutWarningTimer);
            clearTimeout(sessionExpireTimer);
            timeoutWarningTimer = setTimeout(showSessionWarning, warningTime);
            sessionExpireTimer = setTimeout(forceLogout, sessionTimeout);
        }
        function resetTimers() {
            clearTimeout(timeoutWarningTimer);
            clearTimeout(sessionExpireTimer);
            startSessionTimers();
        }

        function showSessionWarning() {
            Swal.fire({
                icon: 'info',
                title: 'Session Expiring Soon',
                text: 'Your session will expire in ' + warningBeforeMinutes + ' minutes. Click OK to stay logged in.',
                confirmButtonText: 'Stay Logged In',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then(() => {
                resetTimers();
            });
        }

        function forceLogout() {
            Swal.fire({
                icon: 'warning',
                title: 'Session Expired',
                text: 'Your session has timed out. Please log in again to continue.',
                confirmButtonText: 'OK',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then(() => {
                window.location.href = '/Pages/LoginPage.aspx';
            });
        }
    </script>
</body>
</html>
